{
  "name": "chunge-space",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "db:push": "prisma db push",
    "postinstall": "prisma generate",
    "pages:build": "npx @cloudflare/next-on-pages",
    "pages:deploy": "npx wrangler pages deploy .vercel/output",
    "cf:deploy": "npm run build && npm run pages:build && npm run pages:deploy",
    "db:d1:sql": "npx prisma migrate diff --from-empty --to-schema-datamodel prisma/schema.prisma --script > prisma/init.sql",
    "db:d1:push:local": "npx wrangler d1 execute chunge-space-db --local --file=./prisma/init.sql",
    "db:d1:push:remote": "npx wrangler d1 execute chunge-space-db --remote --file=./prisma/init.sql"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "@prisma/adapter-d1": "^6.2.1",
    "bcryptjs": "^2.4.3",
    "next": "^15.1.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "^1.13.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.4",
    "@types/react-dom": "^19.0.2",
    "prisma": "^6.2.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "wrangler": "^4.0.0"
  }
}
